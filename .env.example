# Copy to .env.local and fill in values. Never commit real secrets.
# Server-only Supabase credentials (used by the joinBeta server action).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Resend API key for the beta verification email.
RESEND_API_KEY=
# Defaults to: EquityCairn <onboarding@resend.dev>
EMAIL_FROM=
# Base URL used in email links. Defaults to: http://localhost:3000
SITE_URL=
# Number of trusted proxies in front of the app (x-forwarded-for is read from
# the right). Defaults to 1; use 2 behind a Google HTTPS load balancer.
TRUSTED_PROXY_HOPS=
