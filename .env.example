# Copy to .env.local and fill in values. Never commit real secrets.
# Server-only Supabase credentials (used by the sign-up server actions).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Resend API key for the beta verification email. Test sender only delivers to the Resend account address.
RESEND_API_KEY=
# Defaults to: EquityCairn <onboarding@resend.dev>
EMAIL_FROM=
# Base URL used in email links. Defaults to http://localhost:3000 outside production. REQUIRED in production: no email is sent if unset.
SITE_URL=
# Number of trusted proxies in front of the app (x-forwarded-for is read from
# the right). Defaults to 1; use 2 behind a Google HTTPS load balancer.
# With no proxy in front, x-forwarded-for is fully client-controlled.
TRUSTED_PROXY_HOPS=
